# Ignore raw/private data, local environments, and generated model artifacts.
data/incoming/**
!data/incoming/.gitkeep
.venv/
__pycache__/
*.py[cod]
# Model weights stay out of git; the checksum list and per-checkpoint
# provenance records are tracked so a clone can still verify what it is given.
checkpoints/**
!checkpoints/
!checkpoints/*/
!checkpoints/SHA256SUMS
!checkpoints/**/provenance.json
reports/generated/**
*.pt
*.pth
*.onnx
*.zip

data/raw/**
!data/raw/.gitkeep

kaggle_upload/**
!kaggle_upload/.gitkeep
.venv*/
.smoke.log
.merge.log
.pytest_cache/
.cocreate/

# Built documents and LaTeX products are regenerated from source, never committed.
*.pdf
*.docx
*.aux
*.log
*.out
*.toc
*.synctex.gz
thesis/build/
thesis/submission/build/

# Local AI-assistant tooling
.claude/
