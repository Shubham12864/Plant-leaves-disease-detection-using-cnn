# Ignore raw/private data, local environments, and generated model artifacts.
data/incoming/**
!data/incoming/.gitkeep
.venv/
__pycache__/
*.py[cod]
# Model weights stay out of git; the checksum list and per-checkpoint
# provenance records are tracked so a clone can still verify what it is given.
checkpoints/**
!checkpoints/
!checkpoints/*/
!checkpoints/SHA256SUMS
!checkpoints/**/provenance.json
reports/generated/**
*.pt
*.pth
*.onnx
!reports/phase2_baseline/plantvillage_smallcnn_best.pt

data/raw/**
!data/raw/.gitkeep

kaggle_upload/**
!kaggle_upload/.gitkeep
.venv*/
.smoke.log
.merge.log
.pytest_cache/
.cocreate/
thesis/build/
reports/thesis/*.pdf
